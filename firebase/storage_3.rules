rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }
    function profileExists(uid) {
      return firestore.exists(profilePath(uid));
    }
    function profile(uid) {
      return firestore.get(profilePath(uid)).data;
    }
    function isTrainer() {
      return signedIn() && profileExists(request.auth.uid)
        && profile(request.auth.uid).role == 'trainer';
    }
    function activeOwner(uid) {
      return signedIn() && request.auth.uid == uid && profileExists(uid)
        && profile(uid).role == 'student' && profile(uid).status == 'active';
    }
    function validJpegUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 700 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    match /progressPhotos/{uid}/{photoId}.jpg {
      allow read: if isTrainer() || activeOwner(uid);
      allow create, update: if activeOwner(uid) && validJpegUpload();
      allow delete: if activeOwner(uid);
    }
    match /freeMealLogs/{uid}/{photoId}.jpg {
      allow read: if isTrainer() || activeOwner(uid);
      allow create, update: if activeOwner(uid) && validJpegUpload();
      allow delete: if activeOwner(uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
